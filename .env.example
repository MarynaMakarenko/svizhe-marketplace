# Скопіюйте цей файл у .env та змініть значення перед запуском у продакшені.

# --- База даних ---
POSTGRES_DB=svizhe
POSTGRES_USER=svizhe
POSTGRES_PASSWORD=change_me_please

# --- Системна частина (API) ---
# Довгий випадковий рядок, яким підписуються токени входу
JWT_SECRET=change_me_to_a_long_random_string
# Скільки діє токен входу
JWT_EXPIRES_IN=7d
# Заповнити базу демонстраційними даними під час першого запуску (true/false)
SEED_ON_START=true

# --- Інтерфейс ---
# Порт, на якому сайт буде доступний у браузері
WEB_PORT=8088
